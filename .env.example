GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_MODE=auto
ERROR_RATE_THRESHOLD=0.05

# Brevo SMTP relay; add your Brevo SMTP key and verified sender address.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
ALERT_EMAIL_FROM=alerts@your-verified-domain.com
ALERT_EMAIL_TO=you@example.com

SANDBOX_URL=http://127.0.0.1:8001
BACKEND_URL=http://127.0.0.1:8000
PORTAL_URL=http://127.0.0.1:8002
PORTAL_USER=autoheal_bot
PORTAL_PASS=sandbox-demo-password

DB_PATH=data/autoheal.db
